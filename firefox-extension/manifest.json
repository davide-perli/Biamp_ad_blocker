{
    "name":  "Biamp Ad Blocker",
    "version":  "1.7",
    "description":  "DNS adware-malware blocker. Details and source code available at https://github.com/davide-perli/Biamp_ad_blocker.",
    "permissions":  ["declarativeNetRequest"],
    "host_permissions":  ["<all_urls>"],
    "browser_specific_settings":  {
        "gecko":  {
            "id":  "davide-ad-blocker@biamp",
            "strict_min_version":  "142.0",
            "data_collection_permissions":  {"required":  ["none"]}
        }
    },
    "declarative_net_request":  {
        "rule_resources":  [
            {"id":  "rules_1", "enabled":  true, "path":  "rules_1.json"},
            {"id":  "rules_2", "enabled":  true, "path":  "rules_2.json"},
            {"id":  "rules_3", "enabled":  true, "path":  "rules_3.json"},
            {"id":  "rules_4", "enabled":  true, "path":  "rules_4.json"},
            {"id":  "rules_5", "enabled":  true, "path":  "rules_5.json"},
            {"id":  "rules_6", "enabled":  true, "path":  "rules_6.json"},
            {"id":  "rules_7", "enabled":  true, "path":  "rules_7.json"},
            {"id":  "rules_8", "enabled":  true, "path":  "rules_8.json"}
        ]
    },
    "icons":  {
        "16":   "icons/logo_16x16.png",
        "32":   "icons/logo_32x32.png",
        "48":   "icons/logo_48x48.png",
        "96":   "icons/logo_96x96.png",
        "128":  "icons/logo_128x128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/logo_16x16.png",
            "32": "icons/logo_32x32.png"
        },
        "default_title": "Biamp Ad Blocker"
    },
    "manifest_version":  3
}