{
    "name":  "Biamp Ad Blocker",
    "version":  "1.6",
    "description":  "DNS adware-malware blocker. Details and source code available at https://github.com/davide-perli/Biamp_ad_blocker.",
    "permissions":  ["declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
    "host_permissions":  ["all_urls"],
    "declarative_net_request":  {
        "rule_resources":  [
            {"id":  "rules_1", "enabled":  true, "path":  "rules_1.json"},
            {"id":  "rules_2", "enabled":  true, "path":  "rules_2.json"},
            {"id":  "rules_3", "enabled":  true, "path":  "rules_3.json"}
        ]
    },
    "icons":  {
        "16":  "icons/logo_16x16.png",
        "48":  "icons/logo_48x48.png",
        "128":  "icons/logo_128x128.png",
        "256":  "icons/logo_256x256.png"
    },
    "manifest_version":  3
}